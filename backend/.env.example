# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, works on Render).
# The transaction pooler (port 6543) also works.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5
# Optional: keep all tables in a separate Postgres schema (e.g. a throwaway "charm_test" for testing).
# DB_SCHEMA=

# Comma-separated list of allowed frontend origins (local + your Vercel URL)
CORS_ORIGINS=http://localhost:3000
# Optional regex to also allow Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://charm-studio-[a-z0-9]+-<your-vercel-team>\.vercel\.app

# --- Login ---------------------------------------------------------------
# AUTH_SECRET signs login tokens AND encrypts saved WhatsApp tokens (32+ random chars).
# Don't change it once numbers are saved, or you'll have to re-enter their tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=<random 32+ character string>
# Used ONLY for the very first login. Afterwards you log in with the email + password you choose
# in the app, and this value can be removed.
ADMIN_PASSWORD=<choose a strong password>
# Emergency way back in if you're locked out and email reset fails: set it, log in with it,
# choose a new password, then DELETE it. Leave empty normally.
# RESET_PASSWORD=

# Password reset emails via Resend (resend.com). With the default test sender, emails only reach
# the address you signed up to Resend with, so use that as your account email.
# RESEND_API_KEY=<re_... key from resend.com>
# RESEND_FROM=Charm.Studio <onboarding@resend.dev>
# Where reset links point (your site). Falls back to the requesting site if it's in CORS_ORIGINS.
# FRONTEND_URL=http://localhost:3000

# --- AI ------------------------------------------------------------------
# AI provider: "anthropic" (Claude, default) or "ollama"
AI_PROVIDER=anthropic

# --- anthropic: key from platform.claude.com (separate from a Claude Pro subscription)
ANTHROPIC_API_KEY=<your key>
# Optional override; defaults to the latest Sonnet.
# claude-haiku-5-5 is the cheapest choice for the read-only bot (about Rs 10/day at 1,500 messages).
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- ollama: Ollama Cloud (key from ollama.com) or a self-hosted server
# OLLAMA_API_KEY=<your ollama key>
# OLLAMA_MODEL=<model name from ollama.com, e.g. gpt-oss:120b>
# OLLAMA_BASE_URL=https://ollama.com   # or http://localhost:11434 for a local server (no key needed)

# --- WhatsApp ------------------------------------------------------------
# Numbers are added in the app: Settings -> WhatsApp numbers.
WA_GRAPH_VERSION=v20.0
WA_VERIFY_TOKEN=<any secret string you choose, also entered in the Meta webhook settings>

# Read-only bot: seconds to wait after a customer's last message before reading the chat
# READ_DEBOUNCE_SECONDS=20
# 360dialog API base (only change for their sandbox)
# D360_BASE_URL=https://waba-v2.360dialog.io

# Optional: force the public URL used for webhook callbacks (e.g. https://charm-studio-api.onrender.com)
# PUBLIC_BASE_URL=

# Legacy: numbers defined here are imported into Settings ONCE, on the first start of this version.
# WA_NUMBERS=main
# WA_MAIN_PHONE_ID=<Meta phone number id>
# WA_MAIN_TOKEN=<Meta access token>
# WA_MAIN_DISPLAY=<display phone number, e.g. +91 98xxxxxxx>
# WA_MAIN_VERIFY=
